  "description": [
   {
    "value": "Writing under a pen name created in Virginia City, Mark Twain left a legacy that echoes across the unique history of the Silver State.",
    "lang": "en",
    "via": "llm:export_1.xml: item[title='Mark Twain']/description (field-name-body)",
    "file": "P7689.json",
    "uri": false
   },
   {
    "value": "Samuel Langhorne Clemens is one of the nation's most beloved authors. As Mark Twain, he wrote such classics as Tom Sawyer (1876), Huckleberry Finn (1884), and The Prince and the Pauper (1881). His life and career are the property of several states including Nevada, which played an essential role in his development.",
    "lang": "en",
    "via": "llm-page:samuel-clemens article, opening paragraph",
    "file": "P7689.json",
    "uri": false
   }
  ],
