  "description": [
   {
    "value": "Portrait photograph taken by A. F. Bradley in New York, 1907. The Mark Twain Prize for American Humor, presented by The John F. Kennedy Center for the Performing Arts, was established in 1998. Twain was awarded an honorary Doctor of Letters (D.Litt.) by Yale University in 1901 and a Doctor of Law by the University of Missouri in 1902. Oxford University awarded him a Doctorate of Law in 1907.",
    "lang": "en",
    "via": "llm-page:Notes",
    "file": "P9707.json",
    "uri": false
   }
