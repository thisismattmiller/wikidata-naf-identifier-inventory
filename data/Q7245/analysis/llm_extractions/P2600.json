   "description": [
     {"value": "Mark Twain, whose real name was Samuel Langhorne Clemens, was known as America's \"greatest humorist.\"", "lang": "en", "via": "embedded_microdata.json: $[0].mainEntity.description[0]"},
     {"value": "סמואל לנגהורן קלמנס, נודע בשם העט שלו מארק טוויין (30 בנובמבר 1835 – 21 באפריל 1910) היה סופר והומוריסט אמריקני שיצירותיו נודעות בהומור הציני שלהן, בסאטירה החברתית החריפה, בתיאור הריאליסטי של מקומות ושפה ובהתנגדות לצביעות ולדיכוי.", "lang": "he", "via": "embedded_microdata.json: $[0].mainEntity.description[1]"},
     {"value": "Samuel Langhorne Clemens (1835–1910), kjent under sitt litterære pseudonym Mark Twain, var en amerikansk humorist, forfatter, journalist og foreleser.", "lang": "no", "via": "embedded_microdata.json: $[0].mainEntity.description[2]"},
     {"value": "Genealogy profile for Mark Twain", "lang": "en", "via": "embedded_opengraph.json: $[0]['og:description']"}
